{
  "name": "multi-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI-first multi-agent workflow system for work operations.",
  "bin": {
    "agent-workflows": "./dist/cli.js"
  },
  "scripts": {
    "workflow": "tsx src/cli.ts workflow",
    "workflow:mock": "AGENT_WORKFLOWS_MOCK=1 tsx src/cli.ts workflow",
    "list": "tsx src/cli.ts list",
    "templates": "tsx src/cli.ts templates",
    "evaluate": "tsx src/cli.ts evaluate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openai/agents": "^0.1.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
